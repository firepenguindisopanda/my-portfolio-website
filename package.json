  "scripts": {
    "start": "vite",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run",
    "lint": "eslint src --ext .js,.jsx --report-unused-disable-directives",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
