# Copy to .env for local development. .env is gitignored.
#
# Vite inlines VITE_-prefixed variables into the bundle at BUILD time, not at
# runtime, so these must be present in whatever environment runs `npm run
# build` - your machine for a manual `firebase deploy`, or GitHub Actions
# secrets for a CI deploy. A build without them ships a site with analytics
# silently disabled.
#
# The PostHog project key is a public, write-only client key. It is safe in the
# bundle - anyone can read it out of the deployed JavaScript either way.

VITE_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
